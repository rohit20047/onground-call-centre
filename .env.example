# Server only. Never put these in VITE_ variables or commit actual credentials.
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_API_HOST=api.exotel.com
# Agent phone must be a verified Exotel user; include country code.
EXOTEL_AGENT_NUMBER=
# Your account's assigned ExoPhone, not the agent's personal mobile.
EXOTEL_CALLER_ID=
# Comma-separated approved demo recipients in E.164 form.
EXOTEL_ALLOWED_NUMBERS=
# Required for public production deployments. Share separately with reviewers.
DEMO_ACCESS_TOKEN=
HOST=127.0.0.1
PORT=3000
# Optional persistent directory for real call records (mount a volume on hosting).
# CALLS_DATA_DIR=/var/data/onground
